---
extends: default

ignore: |
  .git
  .ansible
  .build
  inventories/personal/group_vars/all/vault.yml

rules:
  braces:
    max-spaces-inside: 1
    min-spaces-inside: 0
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  document-start: enable
  indentation:
    spaces: 2
    indent-sequences: true
  line-length:
    max: 160
    level: warning
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    check-keys: false
