#!/bin/bash

if [ $# -ge 1 ]; then
    game="$(command -v "$1")" || {
        echo "not found: $1" >&2
        exit 1
    }
    openbox="$(command -v openbox)" || {
        echo "openbox is not installed" >&2
        exit 1
    }
    gamemoderun="$(command -v gamemoderun)" || {
        echo "gamemoderun is not installed" >&2
        exit 1
    }
    tmpgame="/tmp/tmpgame.sh"
    printf '%s &\n%s %s\n' "$openbox" "$gamemoderun" "$game" > "$tmpgame"
    chmod 755 "$tmpgame"
    echo "starting ${game}"
    xinit "$tmpgame" -- :1 -xf86config /etc/X11/xorg.conf.d/20-yugen-nvidia.conf vt"${XDG_VTNR}" || exit 1
else
    echo "not a valid argument" >&2
    exit 1
fi
